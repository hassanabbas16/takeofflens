# ---- Database ----
POSTGRES_USER=takeofflens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=takeofflens
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://takeofflens:change_me_locally@db:5432/takeofflens

# ---- Anthropic ----
# Never commit a real key. Models are read from env so they are never hardcoded.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Checked against https://platform.claude.com/docs/en/about-claude/models/overview 2026-09-17.
# claude-haiku-4-5 is the cheapest current model ($1/$5 per MTok) and supports vision, so one
# model serves all three approaches. 200K context, which is ample for one page.
# Step up to claude-sonnet-5 ($2/$10) if Haiku's recall is not good enough; both are cheaper
# per output token than the model this project previously used.
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5
ANTHROPIC_VISION_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=1
# max_tokens is required by the Messages API; hitting it truncates the extraction.
ANTHROPIC_MAX_TOKENS=8000
# Temperature 0 for determinism. Sonnet 5 and Opus 5 reject sampling parameters outright;
# the client detects that and drops the parameter for those models.
ANTHROPIC_TEMPERATURE=0
# Longest image edge sent to the vision model, to control cost.
VLM_MAX_IMAGE_PX=1536
VLM_JPEG_QUALITY=85
PRICING_PATH=/eval/pricing.yaml

# ---- Dataset (host paths, mounted read-only into the api container) ----
# CubiCasa5K plan root: the directory holding train.txt/val.txt/test.txt and the
# colorful/ high_quality/ high_quality_architectural/ folders.
DATASET_DIR=C:/path/to/datasets/cubicasa5k/cubicasa5k
# COCO-format annotations: train_coco_pt.json / val_coco_pt.json / test_coco_pt.json
DATASET_COCO_DIR=C:/path/to/datasets/cubicasa5k_coco
# Where those land inside the api container (read-only). Leave as-is.
DATASET_MOUNT=/data/cubicasa5k
DATASET_COCO_MOUNT=/data/cubicasa5k_coco

# ---- Storage ----
STORAGE_DIR=/storage

# ---- API ----
API_PORT=8000
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
