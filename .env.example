# ---- Database ----
POSTGRES_USER=takeofflens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=takeofflens
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://takeofflens:change_me_locally@db:5432/takeofflens

# ---- OpenAI ----
# Never commit a real key. Models are read from env so they are never hardcoded.
OPENAI_API_KEY=sk-replace-me
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# ---- Dataset (host paths, mounted read-only into the api container) ----
# CubiCasa5K plan root: the directory holding train.txt/val.txt/test.txt and the
# colorful/ high_quality/ high_quality_architectural/ folders.
DATASET_DIR=C:/path/to/datasets/cubicasa5k/cubicasa5k
# COCO-format annotations: train_coco_pt.json / val_coco_pt.json / test_coco_pt.json
DATASET_COCO_DIR=C:/path/to/datasets/cubicasa5k_coco
# Where those land inside the api container (read-only). Leave as-is.
DATASET_MOUNT=/data/cubicasa5k
DATASET_COCO_MOUNT=/data/cubicasa5k_coco

# ---- Storage ----
STORAGE_DIR=/storage

# ---- API ----
API_PORT=8000
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
