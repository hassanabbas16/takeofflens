# ---- Database ----
POSTGRES_USER=takeofflens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=takeofflens
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://takeofflens:change_me_locally@db:5432/takeofflens

# ---- OpenAI ----
# Never commit a real key. Models are read from env so they are never hardcoded.
OPENAI_API_KEY=sk-replace-me
# Checked against https://developers.openai.com/api/docs/models on 2026-09-17.
# gpt-5.6-terra balances capability and cost ($2/$12 per 1M tokens) and supports both
# vision input and Structured Outputs, so one model serves all three approaches.
# Cheaper: gpt-5.6-luna ($0.20/$1.20). Stronger: gpt-5.6-sol, gpt-6-astra.
# Note gpt-6-astra rejects the temperature parameter; the client detects that and drops it.
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
OPENAI_TEMPERATURE=0
# Longest image edge sent to the vision models, to control cost.
VLM_MAX_IMAGE_PX=1536
VLM_JPEG_QUALITY=85
PRICING_PATH=/eval/pricing.yaml

# ---- Dataset (host paths, mounted read-only into the api container) ----
# CubiCasa5K plan root: the directory holding train.txt/val.txt/test.txt and the
# colorful/ high_quality/ high_quality_architectural/ folders.
DATASET_DIR=C:/path/to/datasets/cubicasa5k/cubicasa5k
# COCO-format annotations: train_coco_pt.json / val_coco_pt.json / test_coco_pt.json
DATASET_COCO_DIR=C:/path/to/datasets/cubicasa5k_coco
# Where those land inside the api container (read-only). Leave as-is.
DATASET_MOUNT=/data/cubicasa5k
DATASET_COCO_MOUNT=/data/cubicasa5k_coco

# ---- Storage ----
STORAGE_DIR=/storage

# ---- API ----
API_PORT=8000
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
